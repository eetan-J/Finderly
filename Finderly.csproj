<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\Finderly.ico')">Assets\Finderly.ico</ApplicationIcon>
    <AssemblyName>Finderly</AssemblyName>
    <RootNamespace>Finderly</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Finderly</Product>
    <Description>A Finder-style file browser and Preview-style viewer for Windows</Description>
    <TieredPGO>true</TieredPGO>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>CA1416;CS0067;CS0649;CS0169;CS0414;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Finderly.png" Condition="Exists('Assets\Finderly.png')" />
    <Resource Include="Assets\Preview.png" Condition="Exists('Assets\Preview.png')" />
  </ItemGroup>

</Project>
